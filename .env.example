# =====================================================================
#  Biến môi trường mẫu. Sao chép thành `.env` rồi điền giá trị thật.
#  KHÔNG commit file `.env`.
# =====================================================================

# --- Chung ---
APP_NAME="LyS Survey"
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true                  # false => log dạng dễ đọc khi dev

# Cổng public khi chạy `docker compose up`
HTTP_PORT=8080
# Cổng host cho dịch vụ hạ tầng (đổi nếu máy đã dùng cổng này)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MAIL_UI_HOST_PORT=8025
SMTP_HOST_PORT=1025
WORKER_CONCURRENCY=2
# URL công khai mà người dùng truy cập (dùng để tạo link khảo sát, QR, email)
PUBLIC_BASE_URL=http://localhost:8080

# --- Bảo mật ---
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Muối băm IP/fingerprint (bảo vệ dữ liệu cá nhân)
HASH_SALT=change-me-too
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
# Chống dò mật khẩu/spam đăng ký (production nên để thấp, vd. 10 và 20)
LOGIN_RATE_PER_MINUTE=10
REGISTER_RATE_PER_HOUR=200
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- PostgreSQL ---
POSTGRES_DB=lys
POSTGRES_USER=lys
POSTGRES_PASSWORD=lys_dev_password
# Chạy API ngoài Docker (make dev) thì dùng localhost; trong Docker Compose
# tên host nội bộ (postgres/redis/mailpit) được cố định trong docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Để trống => tự ghép từ các biến POSTGRES_* ở trên
DATABASE_URL=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Email (SMTP; dev dùng Mailpit, giao diện tại http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LyS Survey <no-reply@lys.local>"
SMTP_USE_TLS=false

# --- Lưu tệp ---
STORAGE_BACKEND=local          # local | s3 (sau này)
STORAGE_LOCAL_ROOT=./var/storage

# --- NLP ---
NLP_MODEL_DIR=./var/models
NLP_SENTIMENT_MODEL=vinai/phobert-base-v2
NLP_BATCH_SIZE=128

# --- Frontend (Next.js) ---
NEXT_PUBLIC_APP_NAME="LyS Survey"
# URL API phía trình duyệt (qua nginx thì để /api)
NEXT_PUBLIC_API_BASE_URL=/api
# URL API phía server Next.js (SSR); trong Docker Compose là http://api:8000
API_INTERNAL_URL=http://localhost:8000

# NLP: phobert yêu cầu artifact train.py; rules chỉ minh họa
NLP_BACKEND=phobert
NLP_MODEL_PATH=
NLP_TOPIC_MODEL=
NLP_BATCH_SIZE=64

# Tải tệp khách: ClamAV clamd INSTREAM; chưa cấu hình thì từ chối upload
UPLOAD_SCANNER_HOST=
UPLOAD_SCANNER_PORT=3310
# Font PDF Unicode khi chạy ngoài Docker
REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
